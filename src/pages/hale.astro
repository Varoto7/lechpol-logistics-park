---
import Layout from '../layouts/Layout.astro';

// Baza naszych hal - łatwo możesz tu dodawać kolejne lub zmieniać dane
const hale = [
    {
        title: "Hala A - Moduł Główny",
        image: "https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?auto=format&fit=crop&w=800&q=80",
        area: "15 000 m²",
        height: "10 m",
        docks: "12",
        description: "Największy obiekt w naszym parku, idealny pod wielkopowierzchniową dystrybucję lub lekką produkcję. Posiada świetliki dachowe i zoptymalizowane ogrzewanie."
    },
    {
        title: "Hala B - Cross-Dock",
        image: "https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=800&q=80",
        area: "8 500 m²",
        height: "10 m",
        docks: "24",
        description: "Hala zaprojektowana specjalnie pod szybkie operacje przeładunkowe (cross-docking). Obustronne doki rozładunkowe znacznie przyspieszają logistykę."
    },
    {
        title: "Hala C - Small Business Unit",
        image: "https://images.unsplash.com/photo-1553413077-190dd305871c?auto=format&fit=crop&w=800&q=80",
        area: "3 200 m²",
        height: "8 m",
        docks: "4",
        description: "Mniejsze moduły magazynowe połączone z reprezentacyjną częścią biurową. Idealne rozwiązanie dla firm e-commerce oraz lokalnych dystrybutorów."
    }
];
---

<Layout title="Hale Magazynowe | Lechpol Logistics Park">
    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen">
        <div class="text-center mb-16">
            <h1 class="text-4xl font-bold text-slate-900 mb-4">Dostępne Hale Magazynowe</h1>
            <p class="text-xl text-gray-600 max-w-2xl mx-auto">Poznaj nasze nowoczesne obiekty logistyczne, zaprojektowane z myślą o optymalizacji Twojego biznesu.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {hale.map((hala) => (
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col group">
                    <div class="h-64 overflow-hidden relative">
                        <!-- Zdjęcie hali z efektem przybliżenia po najechaniu myszką -->
                        <img src={hala.image} alt={hala.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        <div class="absolute top-4 right-4 bg-sky-500 text-white px-3 py-1 rounded-full text-sm font-bold shadow-md">
                            Klasa A
                        </div>
                    </div>
                    <div class="p-6 flex-grow flex flex-col">
                        <h2 class="text-2xl font-bold text-slate-800 mb-3">{hala.title}</h2>
                        <p class="text-gray-600 mb-6 flex-grow leading-relaxed">{hala.description}</p>
                        
                        <!-- Parametry techniczne -->
                        <div class="grid grid-cols-3 gap-4 border-t border-gray-100 pt-6 mt-auto">
                            <div class="text-center">
                                <span class="block text-xs text-gray-500 uppercase tracking-wider mb-1">Powierzchnia</span>
                                <span class="font-bold text-slate-900">{hala.area}</span>
                            </div>
                            <div class="text-center border-l border-gray-100">
                                <span class="block text-xs text-gray-500 uppercase tracking-wider mb-1">Wysokość</span>
                                <span class="font-bold text-slate-900">{hala.height}</span>
                            </div>
                            <div class="text-center border-l border-gray-100">
                                <span class="block text-xs text-gray-500 uppercase tracking-wider mb-1">Doki</span>
                                <span class="font-bold text-slate-900">{hala.docks}</span>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </main>
</Layout>