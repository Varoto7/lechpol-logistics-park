---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lechpol Logistics Park | Strona Główna">
    <main class="min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
        
        <!-- Sekcja Hero (Górna część strony) -->
        <section class="bg-slate-900 text-white py-20 px-4">
            <div class="max-w-7xl mx-auto text-center">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">Nowoczesne centrum logistyczne w Miętnem</h1>
                <p class="text-xl text-gray-300 max-w-2xl mx-auto mb-10">Wysokowydajne węzły przeładunkowe i specjalistyczne magazyny przy trasie S17.</p>
                <a href="/hale" class="inline-block bg-sky-500 hover:bg-sky-600 text-white font-bold py-3 px-8 rounded-xl transition duration-300">
                    Zobacz dostępne hale
                </a>
            </div>
        </section>

        <!-- Kafelki Stref Logistycznych (Teraz z pełnym Dark Mode!) -->
        <section class="py-20 px-4">
            <div class="max-w-7xl mx-auto">
                <div class="grid md:grid-cols-2 gap-8">
                    
                    <!-- Karta 1: Eurocash -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300 flex flex-col group hover:shadow-lg">
                        <span class="text-sm font-bold text-sky-500 dark:text-sky-400 uppercase tracking-wider mb-2 block">FMCG & Dystrybucja</span>
                        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Strefa Eurocash</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-6 flex-grow">
                            Wysokowydajny węzeł przeładunkowy zaprojektowany pod kątem szybkiej rotacji towarów i optymalizacji łańcucha dostaw.
                        </p>
                        
                        <ul class="space-y-4 border-t border-gray-100 dark:border-slate-700 pt-6">
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Zoptymalizowane bramy cross-docking
                            </li>
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Strefy z kontrolowaną temperaturą
                            </li>
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Zaawansowane zarządzanie ruchem (YMS)
                            </li>
                        </ul>
                    </div>

                    <!-- Karta 2: Tatra Spring -->
                    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300 flex flex-col group hover:shadow-lg">
                        <span class="text-sm font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-2 block">Składowanie & Obsługa</span>
                        <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Strefa Tatra Spring</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-6 flex-grow">
                            Specjalistyczny magazyn przystosowany do bezpiecznego przechowywania produktów gotowych oraz wielkogabarytowych.
                        </p>
                        
                        <ul class="space-y-4 border-t border-gray-100 dark:border-slate-700 pt-6">
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Składowanie wysokiego regału (do 12m)
                            </li>
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Wzmocniona nośność posadzki
                            </li>
                            <li class="flex items-center text-slate-700 dark:text-gray-300">
                                <svg class="w-5 h-5 text-indigo-500 dark:text-indigo-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                Całodobowy monitoring i ochrona
                            </li>
                        </ul>
                    </div>

                </div>
            </div>
        </section>
        
    </main>
</Layout>