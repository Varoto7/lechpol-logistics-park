---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel Admina | Zarządzaj Halami">
    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Zarządzaj Ofertą Hal</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Dodawaj nowe obiekty do strony lub usuwaj te nieaktualne.</p>
            </div>
            <a href="/admin" class="inline-flex items-center text-slate-500 hover:text-orange-500 dark:text-slate-400 dark:hover:text-orange-400 font-medium transition-colors">
                <svg class="w-5 h-5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Powrót do menu głównego
            </a>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            
            <!-- Lewa Kolumna: Formularz dodawania -->
            <div class="lg:col-span-1 h-fit bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-6">
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Dodaj nową halę</h2>
                
                <div id="formSuccess" class="hidden mb-4 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-600 dark:text-emerald-400 text-sm font-medium">
                    ✓ Hala została pomyślnie dodana!
                </div>

                <form id="addHallForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Tytuł (np. Hala Magazynowa – Miętne)</label>
                        <input type="text" name="title" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Ścieżka do zdjęcia</label>
                        <input type="text" name="image" required placeholder="/hale/nowa-hala.jpg" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none" />
                        <p class="text-xs text-gray-500 mt-1">Wrzuć najpierw plik zdjęcia do folderu "public/hale/" przez GitHuba.</p>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Powierzchnia</label>
                            <input type="text" name="area" required placeholder="np. 5 000 m²" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Wysokość</label>
                            <input type="text" name="height" required placeholder="np. 10 m" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Ilość doków</label>
                        <input type="text" name="docks" required placeholder="np. Doki + rampy '0'" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Pełny opis</label>
                        <textarea name="description" rows="4" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-orange-500 outline-none"></textarea>
                    </div>

                    <button type="submit" id="submitBtn" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl transition duration-300">
                        Dodaj halę na stronę
                    </button>
                </form>
            </div>

            <!-- Prawa Kolumna: Lista Hal -->
            <div class="lg:col-span-2 bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden">
                <div class="p-6 border-b border-gray-100 dark:border-slate-700">
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Aktualne Hale na stronie</h2>
                </div>
                <div class="p-6">
                    <div id="hallsList" class="space-y-4">
                        <p class="text-gray-500 text-center">Ładowanie...</p>
                    </div>
                </div>
            </div>

        </div>
    </main>
</Layout>

<script is:inline>
    const form = document.getElementById('addHallForm');
    const formSuccess = document.getElementById('formSuccess');
    const submitBtn = document.getElementById('submitBtn');
    const hallsList = document.getElementById('hallsList');

    async function fetchHalls() {
        try {
            const res = await fetch('/api/get-halls');
            const data = await res.json();
            
            if (data.error) throw new Error(data.error);

            if (data.length === 0) {
                hallsList.innerHTML = '<p class="text-gray-500 text-center">Brak hal w bazie.</p>';
                return;
            }

            hallsList.innerHTML = data.map(hall => `
                <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-slate-700/50 rounded-xl border border-gray-100 dark:border-slate-600">
                    <div>
                        <h3 class="font-bold text-slate-900 dark:text-white">${hall.title}</h3>
                        <p class="text-sm text-gray-500 dark:text-gray-400">Pow: ${hall.area} | Doki: ${hall.docks}</p>
                    </div>
                    <button onclick="deleteHall(${hall.id})" class="text-red-500 hover:text-red-700 text-sm font-bold px-3 py-1 bg-red-50 dark:bg-red-500/10 rounded-lg transition-colors">
                        Usuń
                    </button>
                </div>
            `).join('');

        } catch (error) {
            hallsList.innerHTML = `<p class="text-red-500 text-center">Błąd ładowania: ${error.message}</p>`;
        }
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Zapisywanie...';

        try {
            const formData = new FormData(form);
            const res = await fetch('/admin/add-hall', { method: 'POST', body: formData });
            if (!res.ok) throw new Error('Błąd dodawania');

            form.reset();
            formSuccess.classList.remove('hidden');
            setTimeout(() => formSuccess.classList.add('hidden'), 3000);
            
            fetchHalls();
        } catch (error) {
            alert('Wystąpił błąd przy zapisie.');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerText = 'Dodaj halę na stronę';
        }
    });

    window.deleteHall = async function(id) {
        if (!confirm('Czy na pewno chcesz usunąć tę halę z oferty?')) return;
        
        try {
            const formData = new FormData();
            formData.append('id', id);
            await fetch('/admin/delete-hall', { method: 'POST', body: formData });
            fetchHalls();
        } catch (e) {
            alert('Błąd podczas usuwania.');
        }
    };

    fetchHalls();
</script>