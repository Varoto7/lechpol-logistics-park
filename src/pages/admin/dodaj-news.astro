---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel Admina | Aktualności">
    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
        
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Zarządzanie Aktualnościami</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Dodawaj, edytuj i usuwaj wpisy (Pełny CRUD)</p>
            </div>
            <a href="/admin/wiadomosci" class="text-sky-500 hover:text-sky-600 font-medium transition-colors">Przejdź do wiadomości →</a>
        </div>

        <div class="grid lg:grid-cols-3 gap-8">
            
            <!-- Lewa Kolumna: Formularz dodawania / edycji -->
            <div class="lg:col-span-1 h-fit bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-6 transition-colors duration-300">
                
                <div class="flex justify-between items-center mb-6">
                    <h2 id="formTitle" class="text-xl font-bold text-slate-900 dark:text-white">Dodaj nowy wpis</h2>
                    <button type="button" id="cancelEditBtn" onclick="cancelEdit()" class="hidden text-sm text-gray-500 hover:text-red-500 transition-colors font-medium">
                        ✕ Anuluj edycję
                    </button>
                </div>
                
                <div id="formSuccess" class="hidden mb-4 p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-emerald-600 dark:text-emerald-400 text-sm font-medium">
                    ✓ Akcja zakończona sukcesem!
                </div>

                <form id="addNewsForm" class="space-y-4">
                    <!-- Ukryte pole ID dla trybu edycji -->
                    <input type="hidden" id="editId" name="id" value="" />

                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Tytuł</label>
                        <input type="text" id="title" name="title" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="Np. Nowa hala w Miętnem" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Treść</label>
                        <textarea id="content" name="content" rows="6" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="Treść aktualności..."></textarea>
                    </div>
                    <button type="submit" id="submitNewsBtn" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-bold py-3 rounded-xl transition duration-300 disabled:opacity-50">
                        Opublikuj wpis
                    </button>
                </form>
            </div>

            <!-- Prawa Kolumna: Lista istniejących newsów -->
            <div class="lg:col-span-2 bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 overflow-hidden transition-colors duration-300">
                <div class="p-6 border-b border-gray-100 dark:border-slate-700">
                    <h2 class="text-xl font-bold text-slate-900 dark:text-white">Opublikowane aktualności</h2>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 dark:bg-slate-700/50 border-b border-gray-100 dark:border-slate-700 text-sm font-semibold text-slate-600 dark:text-slate-300">
                                <th class="p-4 w-1/3">Tytuł / Data</th>
                                <th class="p-4 w-1/2">Treść (fragment)</th>
                                <th class="p-4 text-right">Akcje</th>
                            </tr>
                        </thead>
                        <tbody id="newsTableBody" class="divide-y divide-gray-100 dark:divide-slate-700">
                            <tr>
                                <td colspan="3" class="p-8 text-center text-gray-500 dark:text-gray-400">Ładowanie wpisów...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Nawigacja Stronicowania (Paginacja) -->
                <div class="p-4 border-t border-gray-100 dark:border-slate-700 flex items-center justify-between bg-slate-50/50 dark:bg-slate-800/50">
                    <button 
                        id="prevBtn" 
                        onclick="changePage(-1)" 
                        disabled
                        class="px-3 py-1.5 bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-600 transition disabled:opacity-40 disabled:cursor-not-allowed"
                    >
                        ← Poprzednia
                    </button>

                    <span id="pageIndicator" class="text-sm font-medium text-gray-600 dark:text-gray-300">
                        Strona 1
                    </span>

                    <button 
                        id="nextBtn" 
                        onclick="changePage(1)" 
                        disabled
                        class="px-3 py-1.5 bg-white dark:bg-slate-700 border border-gray-200 dark:border-slate-600 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-200 hover:bg-gray-50 dark:hover:bg-slate-600 transition disabled:opacity-40 disabled:cursor-not-allowed"
                    >
                        Następna →
                    </button>
                </div>
            </div>

        </div>
    </main>
</Layout>

<script is:inline>
    const form = document.getElementById('addNewsForm');
    const tableBody = document.getElementById('newsTableBody');
    const formSuccess = document.getElementById('formSuccess');
    const submitBtn = document.getElementById('submitNewsBtn');
    
    // Zmienne do zarządzania stanem edycji
    const formTitle = document.getElementById('formTitle');
    const cancelEditBtn = document.getElementById('cancelEditBtn');
    const editIdInput = document.getElementById('editId');
    const titleInput = document.getElementById('title');
    const contentInput = document.getElementById('content');

    // Globalne zmienne do paginacji
    let allNews = [];
    let currentPage = 1;
    const PAGE_SIZE = 20;

    // 1. POBIERANIE (READ) Z PAGINACJĄ
    async function fetchNews(page = 1) {
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const pageIndicator = document.getElementById('pageIndicator');

        tableBody.innerHTML = `<tr><td colspan="3" class="p-8 text-center text-gray-500 dark:text-gray-400">Ładowanie wpisów...</td></tr>`;

        try {
            const response = await fetch(`/api/get-news?page=${page}`);
            const data = await response.json();
            
            if (!Array.isArray(data) || data.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="3" class="p-8 text-center text-gray-500 dark:text-gray-400">Brak opublikowanych aktualności.</td></tr>`;
                if (nextBtn) nextBtn.disabled = true;
                if (prevBtn) prevBtn.disabled = (page === 1);
                return;
            }

            // Sprawdzamy czy backend zwrócił więcej niż 20 elementów (21-szy to dowód na istnienie kolejnej strony)
            const hasNextPage = data.length > PAGE_SIZE;
            const itemsToRender = hasNextPage ? data.slice(0, PAGE_SIZE) : data;

            allNews = itemsToRender; 
            currentPage = page;

            if (pageIndicator) pageIndicator.innerText = `Strona ${currentPage}`;
            if (prevBtn) prevBtn.disabled = (currentPage === 1);
            if (nextBtn) nextBtn.disabled = !hasNextPage;

            tableBody.innerHTML = itemsToRender.map(news => {
                const dateObj = new Date(news.created_at);
                const formattedDate = dateObj.toLocaleDateString('pl-PL');
                const shortContent = news.content.length > 60 ? news.content.substring(0, 60) + '...' : news.content;

                return `
                    <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors">
                        <td class="p-4 align-top">
                            <span class="block text-sm font-bold text-slate-900 dark:text-white">${news.title}</span>
                            <span class="block text-xs text-gray-500 dark:text-gray-400 mt-1">${formattedDate}</span>
                        </td>
                        <td class="p-4 text-sm text-slate-700 dark:text-gray-300 align-top">
                            ${shortContent}
                        </td>
                        <td class="p-4 text-right align-top whitespace-nowrap">
                            <button onclick="startEdit(${news.id})" class="inline-flex items-center px-3 py-1.5 bg-amber-50 text-amber-600 hover:bg-amber-100 dark:bg-amber-500/10 dark:hover:bg-amber-500/20 dark:text-amber-400 rounded-lg text-xs font-semibold transition-colors mr-2">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                Edytuj
                            </button>
                            <button onclick="deleteNews(${news.id})" class="inline-flex items-center px-3 py-1.5 bg-red-50 text-red-600 hover:bg-red-100 dark:bg-red-500/10 dark:hover:bg-red-500/20 dark:text-red-400 rounded-lg text-xs font-semibold transition-colors">
                                <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                Usuń
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        } catch (error) {
            tableBody.innerHTML = `<tr><td colspan="3" class="p-8 text-center text-red-500">Błąd podczas pobierania wpisów.</td></tr>`;
        }
    }

    window.changePage = function(delta) {
        const newPage = currentPage + delta;
        if (newPage >= 1) {
            fetchNews(newPage);
        }
    };

    window.startEdit = function(id) {
        const targetNews = allNews.find(n => n.id === id);
        if (!targetNews) return;

        editIdInput.value = targetNews.id;
        titleInput.value = targetNews.title;
        contentInput.value = targetNews.content;

        formTitle.innerText = "Edytuj wpis";
        submitBtn.innerText = "Zapisz zmiany";
        cancelEditBtn.classList.remove('hidden');
        
        form.scrollIntoView({ behavior: 'smooth' });
    };

    window.cancelEdit = function() {
        form.reset();
        editIdInput.value = "";
        formTitle.innerText = "Dodaj nowy wpis";
        submitBtn.innerText = "Opublikuj wpis";
        cancelEditBtn.classList.add('hidden');
    };

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const isEditMode = editIdInput.value !== "";
        submitBtn.innerText = isEditMode ? 'Zapisywanie...' : 'Publikowanie...';
        submitBtn.disabled = true;
        formSuccess.classList.add('hidden');

        const formData = new FormData(form);
        const endpoint = isEditMode ? '/admin/update-news' : '/admin/dodaj-news';

        try {
            await fetch(endpoint, { 
                method: 'POST',
                body: formData 
            });

            cancelEdit();
            formSuccess.innerText = isEditMode ? '✓ Zmiany zostały zapisane!' : '✓ Wpis został opublikowany!';
            formSuccess.classList.remove('hidden');
            setTimeout(() => formSuccess.classList.add('hidden'), 4000);
            
            fetchNews(currentPage);
        } catch (error) {
            alert('Wystąpił błąd podczas zapisywania.');
        } finally {
            submitBtn.innerText = isEditMode ? 'Zapisz zmiany' : 'Opublikuj wpis';
            submitBtn.disabled = false;
        }
    });

    window.deleteNews = async function(id) {
        if (!confirm('Czy na pewno chcesz usunąć ten wpis?')) return;

        try {
            const response = await fetch(`/admin/delete-news?id=${id}`, { method: 'DELETE' });
            if (response.ok) {
                if (editIdInput.value == id) cancelEdit(); 
                fetchNews(currentPage);
            } else {
                alert('Błąd serwera podczas usuwania.');
            }
        } catch (error) {
            alert('Błąd połączenia. Spróbuj ponownie.');
        }
    };

    fetchNews(1);
</script>