---
import Layout from '../../layouts/Layout.astro';

const status = Astro.url.searchParams.get('status');
---

<Layout title="Panel Admina - Dodaj News">
    <main class="max-w-4xl mx-auto px-4 py-16 w-full flex-grow">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-bold text-slate-900">Panel Administratora</h1>
            <span class="bg-red-100 text-red-700 px-3 py-1 rounded-full text-sm font-bold border border-red-200">Zastrzeżone</span>
        </div>

        {status === 'success' && (
            <div class="mb-8 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg text-center font-medium">
                Aktualność została pomyślnie opublikowana!
            </div>
        )}

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
            <h2 class="text-xl font-bold text-slate-800 mb-6">Dodaj nową aktualność</h2>
            
            <form action="/admin/dodaj-news" method="POST" class="space-y-6">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Tytuł aktualności</label>
                    <input type="text" name="title" required placeholder="np. Otwieramy nową halę magazynową..." class="w-full px-4 py-3 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Treść (możesz używać HTML)</label>
                    <textarea name="content" rows="8" required placeholder="Wpisz treść wiadomości..." class="w-full px-4 py-3 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500"></textarea>
                </div>

                <button type="submit" class="bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                    Opublikuj News
                </button>
            </form>
        </div>
    </main>
</Layout>