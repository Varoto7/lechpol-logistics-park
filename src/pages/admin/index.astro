---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Panel Administratora | Lechpol Logistics">
    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
        
        <!-- Nagłówek -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
            <div>
                <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Panel Administratora</h1>
                <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">Zarządzaj treścią i ustawieniami parku logistycznego</p>
            </div>
            <a href="/" class="inline-flex items-center px-4 py-2 bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-xl text-sm font-medium text-slate-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 transition-colors shadow-sm">
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                Wróć na stronę główną
            </a>
        </div>

        <!-- Siatka Modułów -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Kafelek: Mapa -->
            <a href="/admin/mapa" class="group block h-full bg-white dark:bg-slate-800 rounded-2xl p-6 border border-gray-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-sky-500/30 dark:hover:border-sky-500/30 transition-all duration-300">
                <div class="w-12 h-12 bg-sky-50 dark:bg-sky-500/10 text-sky-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-sky-500 transition-colors">Interaktywna Mapa</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400">Edytuj statusy hal (dostępne, wynajęte, rezerwacja), zmieniaj powierzchnię i opisy na mapie głównej.</p>
            </a>

            <!-- Kafelek: Wiadomości -->
            <a href="/admin/wiadomosci" class="group block h-full bg-white dark:bg-slate-800 rounded-2xl p-6 border border-gray-100 dark:border-slate-700 shadow-sm hover:shadow-md hover:emerald-500/30 dark:hover:border-emerald-500/30 transition-all duration-300">
                <div class="w-12 h-12 bg-emerald-50 dark:bg-emerald-500/10 text-emerald-500 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform duration-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-2 group-hover:text-emerald-500 transition-colors">Skrzynka Wiadomości</h2>
                <p class="text-sm text-gray-500 dark:text-gray-400">Przeglądaj zapytania ofertowe i wiadomości wysłane przez klientów z formularza kontaktowego.</p>
            </a>

            <!-- Miejsce na przyszłe moduły (np. Aktualności/Blog) -->
            <div class="h-full bg-gray-50 dark:bg-slate-800/50 rounded-2xl p-6 border border-dashed border-gray-200 dark:border-slate-700 flex flex-col items-center justify-center text-center opacity-60">
                <div class="w-12 h-12 bg-gray-200 dark:bg-slate-700 text-gray-400 rounded-xl flex items-center justify-center mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                </div>
                <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Nowy Moduł</h2>
                <p class="text-xs text-gray-500 dark:text-gray-400">Miejsce na kolejne funkcje (np. dodawanie aktualności).</p>
            </div>

        </div>
    </main>
</Layout>