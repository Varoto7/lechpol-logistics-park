---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt | Lechpol Logistics Park">
    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen">
        <div class="text-center mb-16">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">Skontaktuj się z nami</h1>
            <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Masz pytania o dostępne powierzchnie magazynowe? Napisz do nas lub zadzwoń.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            
            <!-- Karta danych kontaktowych -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Dane kontaktowe</h2>
                <ul class="space-y-6">
                    <li class="flex items-center text-slate-700 dark:text-gray-300">
                        <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        Miętne, bezpośrednio przy trasie S17<br>(węzeł Garwolin Zachód)
                    </li>
                    <li class="flex items-center text-slate-700 dark:text-gray-300">
                        <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        +48 123 456 789
                    </li>
                    <li class="flex items-center text-slate-700 dark:text-gray-300">
                        <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        kontakt@lechpol-logistics.pl
                    </li>
                </ul>
            </div>

            <!-- Karta formularza -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Napisz do nas</h2>
                <form class="space-y-4" onsubmit="event.preventDefault(); alert('Formularz testowy.');">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Imię i nazwisko</label>
                        <input type="text" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="Jan Kowalski" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Adres e-mail</label>
                        <input type="email" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="jan@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Wiadomość</label>
                        <textarea rows="4" class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="W czym możemy pomóc?"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-bold py-3 rounded-xl transition duration-300 mt-2">
                        Wyślij wiadomość
                    </button>
                </form>
            </div>

        </div>
    </main>
</Layout>