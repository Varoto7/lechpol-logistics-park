---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kontakt | Lechpol Logistics Park">
    <!-- Skrypt Turnstile od Cloudflare -->
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen bg-slate-50 dark:bg-slate-900 transition-colors duration-300">
        <div class="text-center mb-16">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-4">Skontaktuj się z nami</h1>
            <p class="text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Masz pytania o dostępne powierzchnie magazynowe? Napisz do nas lub zadzwoń.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
            
            <!-- Dane kontaktowe (Interaktywne) -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Dane kontaktowe</h2>
                <ul class="space-y-6">
                    
                    <!-- Adres -> Dokładna lokalizacja Lechpol w Google Maps -->
                    <li>
                        <a 
                            href="https://maps.app.goo.gl/YvvQ7cbvydxa4wUSA" 
                            target="_blank" 
                            rel="noopener noreferrer" 
                            class="flex items-start text-slate-700 dark:text-gray-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors group"
                        >
                            <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <div>
                                <span class="font-medium block">Miętne, przy trasie S17</span>
                                <span class="text-sm text-gray-500 dark:text-gray-400 group-hover:underline">(węzeł Garwolin Zachód) — Otwórz w Mapach ↗</span>
                            </div>
                        </a>
                    </li>

                    <!-- Telefon -> Uruchamia dzwonienie na smartfonie -->
                    <li>
                        <a 
                            href="tel:+48123456789" 
                            class="flex items-center text-slate-700 dark:text-gray-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors group"
                        >
                            <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <span class="font-medium">+48 123 456 789</span>
                        </a>
                    </li>

                    <!-- E-mail -> Otwiera aplikację pocztową -->
                    <li>
                        <a 
                            href="mailto:kontakt@lechpol-logistics.pl" 
                            class="flex items-center text-slate-700 dark:text-gray-300 hover:text-sky-500 dark:hover:text-sky-400 transition-colors group"
                        >
                            <svg class="w-6 h-6 text-sky-500 mr-4 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <span class="font-medium">kontakt@lechpol-logistics.pl</span>
                        </a>
                    </li>

                </ul>
            </div>

            <!-- Formularz -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-100 dark:border-slate-700 p-8 transition-colors duration-300 relative">
                <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Napisz do nas</h2>
                
                <div id="successMessage" class="hidden mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-600 dark:text-emerald-400 text-sm font-medium">
                    ✓ Dziękujemy! Twoja wiadomość została wysłana.
                </div>
                <div id="errorMessage" class="hidden mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-600 dark:text-red-400 text-sm font-medium">
                    Wystąpił błąd podczas wysyłania wiadomości. Spróbuj ponownie.
                </div>

                <form id="contactForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Adres e-mail</label>
                        <input type="email" id="email" name="email" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="jan@example.com" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-gray-300 mb-1">Wiadomość</label>
                        <textarea id="message" name="message" rows="4" required class="w-full px-4 py-2 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-700 text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 outline-none transition-colors" placeholder="W czym możemy pomóc?"></textarea>
                    </div>

                    <!-- WIDGET TURNSTILE -->
                    <div class="cf-turnstile my-4" data-sitekey="0x4AAAAAAEGGv9lLhbXhEIkI"></div>

                    <button type="submit" id="submitBtn" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-bold py-3 rounded-xl transition duration-300 mt-2 disabled:opacity-50 disabled:cursor-not-allowed">
                        Wyślij wiadomość
                    </button>
                </form>
            </div>

        </div>
    </main>
</Layout>

<script is:inline>
    const form = document.getElementById('contactForm');
    const successMsg = document.getElementById('successMessage');
    const errorMsg = document.getElementById('errorMessage');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', async (e) => {
        e.preventDefault(); 
        
        successMsg.classList.add('hidden');
        errorMsg.classList.add('hidden');
        submitBtn.innerText = 'Wysyłanie...';
        submitBtn.disabled = true;

        const formData = new FormData(form);

        try {
            const response = await fetch('/api/kontakt', { 
                method: 'POST',
                body: formData 
            });

            if (response.url.includes('status=success')) {
                form.reset();
                if (window.turnstile) window.turnstile.reset();
                successMsg.classList.remove('hidden');
                setTimeout(() => successMsg.classList.add('hidden'), 5000);
            } else if (response.url.includes('status=bot')) {
                errorMsg.innerText = "Błąd weryfikacji antyspamowej. Spróbuj ponownie.";
                errorMsg.classList.remove('hidden');
            } else {
                errorMsg.innerText = "Błąd wysyłania. Spróbuj ponownie.";
                errorMsg.classList.remove('hidden');
            }
        } catch (error) {
            console.error('Błąd:', error);
            errorMsg.innerText = "Krytyczny błąd połączenia z serwerem.";
            errorMsg.classList.remove('hidden');
        } finally {
            submitBtn.innerText = 'Wyślij wiadomość';
            submitBtn.disabled = false;
        }
    });
</script>