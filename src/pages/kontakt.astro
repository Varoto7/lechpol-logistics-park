---
import Layout from '../layouts/Layout.astro';

let successMessage = "";
let errorMessage = "";

if (Astro.request.method === "POST") {
  try {
    const data = await Astro.request.formData();
    const email = data.get("email");
    const message = data.get("message");

    // Bezpieczne pobranie środowiska Cloudflare z obsługą braku bazy na podglądzie
    const runtime = Astro.locals?.runtime;
    const env = runtime?.env;
    
    if (env && env.DB) {
      await env.DB.prepare(
        "INSERT INTO messages (email, message, created_at) VALUES (?, ?, datetime('now'))"
      ).bind(email, message).run();
      
      successMessage = "Twoja wiadomość została wysłana pomyślnie!";
    } else {
      // Symulacja sukcesu na podglądzie, żeby strona nie wywalała błędu
      successMessage = "Wiadomość została przyjęta (tryb podglądu/symulacji bazy).";
    }
  } catch (e) {
    errorMessage = "Wystąpił błąd podczas wysyłania wiadomości.";
  }
}
---

<Layout title="Kontakt | Lechpol Logistics Park">
    <!-- Pasek Nawigacji -->
    <nav class="bg-slate-900 text-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <a href="/" class="font-bold text-xl tracking-wider hover:text-sky-500 transition">
                    LECHPOL <span class="text-sky-500">LOGISTICS</span>
                </a>
                <div class="hidden md:flex space-x-8 font-medium">
                    <a href="/#o-parku" class="hover:text-sky-500 transition">O Parku</a>
                    <a href="/#strefy" class="hover:text-sky-500 transition">Strefy Najemców</a>
                    <a href="/kontakt" class="text-sky-500 transition">Kontakt</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-16 min-h-screen">
        <h1 class="text-4xl font-bold text-slate-900 mb-12 text-center">Skontaktuj się z nami</h1>
        
        {successMessage && (
            <div class="max-w-2xl mx-auto mb-8 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg text-center font-medium">
                {successMessage}
            </div>
        )}

        {errorMessage && (
            <div class="max-w-2xl mx-auto mb-8 p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg text-center font-medium">
                {errorMessage}
            </div>
        )}
        
        <div class="grid md:grid-cols-2 gap-12 items-start">
            
            <!-- Informacje kontaktowe -->
            <div class="bg-white p-8 md:p-10 rounded-2xl shadow-sm border border-gray-100">
                <h2 class="text-2xl font-bold text-slate-800 mb-6">Dane kontaktowe</h2>
                <p class="text-gray-600 mb-8 leading-relaxed">
                    Masz pytania dotyczące specyfikacji technicznej lub dostępności powierzchni magazynowych? Nasz kierownik centrum logistycznego chętnie udzieli wszelkich informacji.
                </p>
                
                <div class="space-y-6">
                    <div class="flex items-center">
                        <div class="bg-sky-50 p-3 rounded-full mr-4">
                            <span class="text-sky-500 text-2xl">📞</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">Telefon</p>
                            <p class="text-xl font-medium text-slate-800">+48 500 600 700</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center">
                        <div class="bg-sky-50 p-3 rounded-full mr-4">
                            <span class="text-sky-500 text-2xl">✉️</span>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">E-mail (Kierownik Parku)</p>
                            <p class="text-lg font-medium text-slate-800">kierownik@lechpol-logistics.pl</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Formularz kontaktowy -->
            <div class="bg-slate-900 p-8 md:p-10 rounded-2xl shadow-xl text-white">
                <h2 class="text-2xl font-bold mb-6">Napisz wiadomość</h2>
                <form method="POST" class="space-y-5">
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-2">Twój e-mail</label>
                        <input type="email" name="email" required placeholder="jan.kowalski@firma.pl" class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-gray-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-400 mb-2">Wiadomość</label>
                        <textarea name="message" rows="5" required placeholder="Opisz swoje zapotrzebowanie (np. metraż, termin)..." class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder-gray-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition"></textarea>
                    </div>
                    <button type="submit" class="w-full bg-sky-500 hover:bg-sky-600 text-white font-bold py-3 px-4 rounded-lg transition duration-300 shadow-lg shadow-sky-500/30">
                        Wyślij zapytanie
                    </button>
                </form>
            </div>
            
        </div>
    </main>

    <!-- Stopka -->
    <footer class="bg-slate-900 text-gray-400 py-8 border-t border-slate-800 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <p>&copy; 2026 Lechpol Logistics Park. Wszystkie prawa zastrzeżone.</p>
        </div>
    </footer>
</Layout>