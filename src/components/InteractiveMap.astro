---
// src/components/InteractiveMap.astro
---

<section class="py-16 px-4 bg-white dark:bg-slate-800/50 transition-colors duration-300 border-t border-gray-100 dark:border-slate-700/50">
    <div class="max-w-7xl mx-auto">
        
        <!-- Nagłówek sekcji mapy -->
        <div class="text-center mb-10">
            <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-3">Interaktywna Mapa Stref i Hal</h2>
            <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto text-sm md:text-base">
                Kliknij wybraną halę lub strefę na mapie, aby zobaczyć szczegółowe informacje o jej powierzchni i dostępności.
            </p>

            <!-- Legenda statusów -->
            <div class="flex flex-wrap justify-center gap-6 mt-6 text-sm font-medium">
                <div class="flex items-center gap-2">
                    <span class="w-3.5 h-3.5 rounded-full bg-emerald-500 inline-block"></span>
                    <span class="text-slate-700 dark:text-gray-300">Dostępna</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3.5 h-3.5 rounded-full bg-amber-500 inline-block"></span>
                    <span class="text-slate-700 dark:text-gray-300">Rezerwacja</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="w-3.5 h-3.5 rounded-full bg-red-500 inline-block"></span>
                    <span class="text-slate-700 dark:text-gray-300">Wynajęta</span>
                </div>
            </div>
        </div>

        <!-- Kontener z Mapą SVG -->
        <div class="bg-slate-50 dark:bg-slate-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-slate-700 relative overflow-hidden">
            <div id="mapContainer" class="w-full flex justify-center items-center">
                
                <svg viewBox="0 0 800 500" class="w-full h-auto max-w-4xl select-none" id="interactiveMapSvg">
                    <!-- Tło terenu -->
                    <rect x="10" y="10" width="780" height="480" rx="20" fill="#e2e8f0" class="dark:fill-slate-700/50" />
                    <path d="M 20 240 L 780 240" stroke="#cbd5e1" stroke-width="20" stroke-dasharray="10 10" fill="none" class="dark:stroke-slate-600" />
                    
                    <!-- Strefy z dopasowanymi ID do D1 -->
                    <g id="hala1" class="map-zone cursor-pointer transition-all duration-300">
                        <rect x="50" y="50" width="180" height="150" rx="12" class="zone-shape fill-slate-300 stroke-slate-400 stroke-2 transition-all" />
                        <text x="140" y="130" text-anchor="middle" class="fill-slate-800 dark:fill-white font-bold text-sm pointer-events-none">Hala 1</text>
                    </g>

                    <g id="hala2" class="map-zone cursor-pointer transition-all duration-300">
                        <rect x="280" y="50" width="220" height="150" rx="12" class="zone-shape fill-slate-300 stroke-slate-400 stroke-2 transition-all" />
                        <text x="390" y="130" text-anchor="middle" class="fill-slate-800 dark:fill-white font-bold text-sm pointer-events-none">Hala 2</text>
                    </g>

                    <g id="hala3" class="map-zone cursor-pointer transition-all duration-300">
                        <rect x="550" y="50" width="180" height="150" rx="12" class="zone-shape fill-slate-300 stroke-slate-400 stroke-2 transition-all" />
                        <text x="640" y="130" text-anchor="middle" class="fill-slate-800 dark:fill-white font-bold text-sm pointer-events-none">Hala 3</text>
                    </g>

                    <g id="hala4" class="map-zone cursor-pointer transition-all duration-300">
                        <rect x="50" y="280" width="300" height="160" rx="12" class="zone-shape fill-slate-300 stroke-slate-400 stroke-2 transition-all" />
                        <text x="200" y="365" text-anchor="middle" class="fill-slate-800 dark:fill-white font-bold text-sm pointer-events-none">Hala 4 / Strefa Logistyczna</text>
                    </g>
                </svg>

            </div>
        </div>

        <!-- Modal Szczegółów Strefy -->
        <div id="zoneModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
            <div class="bg-white dark:bg-slate-800 rounded-2xl max-w-md w-full p-6 shadow-2xl border border-gray-100 dark:border-slate-700 relative animate-in fade-in zoom-in duration-200">
                
                <button onclick="closeZoneModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-white text-xl font-bold p-1">
                    ✕
                </button>
                
                <div id="modalStatusBadge" class="mb-3"></div>
                <h3 id="modalTitle" class="text-2xl font-bold text-slate-900 dark:text-white mb-1"></h3>
                <p id="modalArea" class="text-sky-500 font-bold text-lg mb-4"></p>
                
                <div class="border-t border-gray-100 dark:border-slate-700 pt-4 mb-6">
                    <span class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Opis szczegółowy</span>
                    <p id="modalDesc" class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed whitespace-pre-line"></p>
                </div>

                <a href="/kontakt" class="block w-full text-center bg-slate-900 dark:bg-sky-600 hover:bg-sky-600 dark:hover:bg-sky-500 text-white font-bold py-3 rounded-xl transition duration-300">
                    Zapytaj o tę strefę
                </a>
            </div>
        </div>

    </div>
</section>

<style>
    .status-dostepna {
        fill: #10b981 !important;
        stroke: #059669 !important;
    }
    .status-rezerwacja {
        fill: #f59e0b !important;
        stroke: #d97706 !important;
    }
    .status-wynajeta {
        fill: #ef4444 !important;
        stroke: #dc2626 !important;
    }

    .map-zone:hover .zone-shape {
        filter: brightness(1.15);
        cursor: pointer;
    }
</style>

<script is:inline>
    let zonesData = {};

    async function initMap() {
        try {
            const response = await fetch('/api/get-zones');
            zonesData = await response.json();

            if (zonesData.error) return;

            Object.keys(zonesData).forEach(id => {
                const zone = zonesData[id];
                const element = document.getElementById(id);

                if (element) {
                    const shape = element.querySelector('.zone-shape') || element;

                    shape.classList.remove('status-dostepna', 'status-rezerwacja', 'status-wynajeta');
                    if (zone.status === 'dostepna') shape.classList.add('status-dostepna');
                    if (zone.status === 'rezerwacja') shape.classList.add('status-rezerwacja');
                    if (zone.status === 'wynajeta') shape.classList.add('status-wynajeta');

                    element.addEventListener('click', (e) => {
                        e.stopPropagation();
                        openZoneModal(zone);
                    });
                }
            });

        } catch (err) {
            console.error("Błąd połączenia z mapą:", err);
        }
    }

    function openZoneModal(zone) {
        const modal = document.getElementById('zoneModal');
        const badge = document.getElementById('modalStatusBadge');
        
        document.getElementById('modalTitle').innerText = zone.nazwa || ('Strefa ' + zone.id);
        document.getElementById('modalArea').innerText = 'Powierzchnia: ' + (zone.powierzchnia || '-');
        document.getElementById('modalDesc').innerText = zone.opis || 'Brak dodatkowego opisu.';

        let badgeHtml = '<span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs font-bold rounded-full">Nieokreślony</span>';
        if (zone.status === 'dostepna') badgeHtml = '<span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">Dostępna</span>';
        if (zone.status === 'rezerwacja') badgeHtml = '<span class="px-3 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">Rezerwacja</span>';
        if (zone.status === 'wynajeta') badgeHtml = '<span class="px-3 py-1 bg-red-100 text-red-700 text-xs font-bold rounded-full">Wynajęta</span>';
        
        badge.innerHTML = badgeHtml;
        modal.classList.remove('hidden');
    }

    window.closeZoneModal = function() {
        document.getElementById('zoneModal').classList.add('hidden');
    };

    window.addEventListener('click', (e) => {
        const modal = document.getElementById('zoneModal');
        if (e.target === modal) {
            closeZoneModal();
        }
    });

    document.addEventListener('DOMContentLoaded', initMap);
</script>