        <div class="px-4 pt-2 pb-4 space-y-2 flex flex-col">
            <a href="/hale" class="block px-3 py-2 text-slate-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-slate-700 rounded-md">Hale Magazynowe</a>
