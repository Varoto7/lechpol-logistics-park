                <!-- Przełącznik Motywu (PC) -->
                <button class="themeToggle p-2 bg-gray-100 dark:bg-slate-700 rounded-full hover:bg-gray-200 dark:hover:bg-slate-600 transition">
                    <svg class="w-5 h-5 text-slate-800 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                    </svg>
                </button>
            </div>

            <!-- Mobile Menu & Theme Button -->
            <div class="md:hidden flex items-center space-x-4">
                 <!-- Przełącznik Motywu (Mobilny) -->
                <button class="themeToggle p-2 bg-gray-100 dark:bg-slate-700 rounded-full">
                    <svg class="w-5 h-5 text-slate-800 dark:text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
